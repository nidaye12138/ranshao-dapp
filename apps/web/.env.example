# =============================================================================
# Chapel (BSC testnet, chainId 97) — copy to apps/web/.env.local for local testing
# Addresses below match the Chapel deploy (see deployments / internal testnet JSON).
# Do not commit .env.local. No private keys belong here.
# =============================================================================

NEXT_PUBLIC_CHAIN_ID=97
NEXT_PUBLIC_BSC_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com

# Optional: leave unset on Chapel so the app does not prefer mainnet RPC.
# NEXT_PUBLIC_BSC_RPC_URL=

# Tokens (Chapel mocks / deploy)
NEXT_PUBLIC_TOKEN_ADDRESS=0xFc3E883Ae47C838df43d4D7AF52885D0c1eb8E3c
NEXT_PUBLIC_SPCXB_ADDRESS=0xBf85ED1e828C6f4A545A60152E87aD8536feaF20
NEXT_PUBLIC_USDT_ADDRESS=0xF532a19475742D27Cb4d97412e27526559a92Df9

# Modules — map from Chapel deploy:
#   ReferralTree→REGISTRY, SwapFacade→SWAP, BurnRouter→BURN (approve spender),
#   DividendPools→DIVIDENDS, ShareholderPool→SHAREHOLDER,
#   EliteStake→ELITE, PrecipitationPool→PRECIP, Treasury→TREASURY
NEXT_PUBLIC_REGISTRY_ADDRESS=0x41B1359Ad459D5180641FA48cce133BFB28fea80
NEXT_PUBLIC_SWAP_ADDRESS=0x627ea7e01F9128d9F2440EE629a974802dcC7DEc
NEXT_PUBLIC_BURN_ADDRESS=0x17ecCDF8A61ef1D85E7087B369c6e944cb33ceF3
NEXT_PUBLIC_DIVIDENDS_ADDRESS=0x6a8AC8ff772ABD58B6BbB48F71e5FC533242E577
NEXT_PUBLIC_SHAREHOLDER_ADDRESS=0x247C913e3A68AB0FE5a965e93AdD9837e4d49851
NEXT_PUBLIC_ELITE_ADDRESS=0x52ECe30E78Fd114C2E16FF2A35295E446785C032
NEXT_PUBLIC_PRECIP_ADDRESS=0xd2aDabF4a345E5e126425065E2FA4e365aD67C73
NEXT_PUBLIC_TREASURY_ADDRESS=0x8C69d8B7d10A27E0EfcaA6e73fBBaB954E7CF562

# The Graph GraphQL HTTP endpoint (server-only). When unset, /api/leaderboard|team|earnings
# return empty payloads with source: "unconfigured".
GRAPH_URL=

# =============================================================================
