# WalletConnect optional later; injected MetaMask works without a project id.
NEXT_PUBLIC_BSC_RPC_URL=https://bsc-dataseed.binance.org
NEXT_PUBLIC_BSC_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com

# --- Project token (BSC mainnet UMplan — owner confirmed) ---
NEXT_PUBLIC_TOKEN_ADDRESS=0xad09D287327C383283820CfCEe7AC0e6C7De7777

# Dividend pool asset (BSC mainnet SPCXB — ≠ UMplan)
NEXT_PUBLIC_SPCXB_ADDRESS=0xbe9D156892E55e7154BcD3cB0FEA677F9D3103E1

# BSC mainnet USDT (Binance-Peg, 18 decimals). Override on testnet with mock USDT.
NEXT_PUBLIC_USDT_ADDRESS=0x55d398326f99059fF775485246999027B3197955

# Fill from deployments/bsc-mainnet.json (or bsc-testnet.json) after UM-plan module deploy
# Map: ReferralTree→REGISTRY, SwapFacade→SWAP, BurnRouter→BURN,
#      DividendPools→DIVIDENDS, ShareholderPool→SHAREHOLDER,
#      EliteStake→ELITE, PrecipitationPool→PRECIP, Treasury→TREASURY
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_SWAP_ADDRESS=
NEXT_PUBLIC_BURN_ADDRESS=
NEXT_PUBLIC_DIVIDENDS_ADDRESS=
NEXT_PUBLIC_SHAREHOLDER_ADDRESS=
NEXT_PUBLIC_ELITE_ADDRESS=
NEXT_PUBLIC_PRECIP_ADDRESS=
NEXT_PUBLIC_TREASURY_ADDRESS=

# The Graph GraphQL HTTP endpoint (server-only). When unset, /api/leaderboard|team|earnings
# return empty payloads with source: "unconfigured" (no fake leaderboard).
# GRAPH_URL=https://api.studio.thegraph.com/query/<id>/umidor-um-plan/version/latest
GRAPH_URL=
