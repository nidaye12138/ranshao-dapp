# WalletConnect optional later; injected MetaMask works without a project id.
NEXT_PUBLIC_BSC_RPC_URL=https://bsc-dataseed.binance.org
NEXT_PUBLIC_BSC_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com

# --- Project token (BSC mainnet UMplan — owner confirmed) ---
# Defaults in addresses.ts if unset. Override for testnet mock/deployed token.
NEXT_PUBLIC_TOKEN_ADDRESS=0xad09D287327C383283820CfCEe7AC0e6C7De7777

# BSC mainnet USDT (Binance-Peg, 18 decimals). Override on testnet with mock USDT.
NEXT_PUBLIC_USDT_ADDRESS=0x55d398326f99059fF775485246999027B3197955

# Fill from deployments/bsc-mainnet.json (or bsc-testnet.json) after module deploy
# Map: ReferralRegistry→REGISTRY, Sale→SALE, MilestoneRewards→MILESTONES,
#      Stake→STAKE, Shareholder→SHAREHOLDER, Treasury→TREASURY
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_SALE_ADDRESS=
NEXT_PUBLIC_MILESTONES_ADDRESS=
NEXT_PUBLIC_STAKE_ADDRESS=
NEXT_PUBLIC_SHAREHOLDER_ADDRESS=
NEXT_PUBLIC_TREASURY_ADDRESS=
